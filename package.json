{
  "name": "arpegginator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc -b && vite build",
    "build:wasm": "bash src/wasm-rust/build.sh",
    "watch:wasm": "bash src/wasm-rust/watch.sh",
    "build:teensy": "cd src/wasm-rust/teensy && cargo build --release",
    "flash:teensy": "bash src/wasm-rust/teensy/build_flash.sh",
    "flash:teensy:reboot": "bash src/wasm-rust/teensy/flash.sh",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cd src/wasm-rust && RUST_MIN_STACK=8388608 cargo test -p arp3-engine -p arp3-synth"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "immer": "^11.1.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "webmidi": "^3.1.16",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
